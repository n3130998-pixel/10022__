-- อนิเมชันสีรุ้ง UI และ ลำโพง
local rotation = 0
RunService.RenderStepped:Connect(function(dt)
    rotation = (rotation + dt * 60) % 360
    for _, grad in ipairs(gradientsToUpdate) do
        grad.Rotation = rotation
    end
    
    for i = #boomboxHighlights, 1, -1 do
        local hl = boomboxHighlights[i]
        if hl and hl.Parent then
            local hue = (tick() * 0.5 + i * 0.1) % 1
            hl.OutlineColor = Color3.fromHSV(hue, 1, 1)
        else
            table.remove(boomboxHighlights, i)
        end
    end
end)

local function setupBoomboxEffect(tool)
    task.wait(0.2)
    local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart")
    if handle then
        local highlight = Instance.new("Highlight")
        highlight.Adornee = tool
        highlight.FillTransparency = 1
        highlight.OutlineTransparency = 0.2
        highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
        highlight.Parent = tool
        table.insert(boomboxHighlights, highlight)
    end
end

local function GetSongInfo(musicId)
    local success, productInfo = pcall(function()
        return MarketplaceService:GetProductInfo(musicId)
    end)
    if success and productInfo then
        return { Name = productInfo.Name or "ไม่ทราบชื่อเพลง", Creator = productInfo.Creator.Name or "ไม่ทราบชื่อคนทำ" }
    else
        return { Name = "ไม่ทราบชื่อเพลง", Creator = "ไม่ทราบชื่อคนทำ" }
    end
end

-- ดึงข้อมูลเพลงแบบไม่ให้เกมค้าง
local lastRequestTick = 0
local function UpdateSongInfo()
    local musicId = IDInput.Text:gsub("%D", "")
    if musicId ~= "" then
        local currentTick = tick()
        lastRequestTick = currentTick
        
        SongInfoLabel.Text = "🎵 กำลังโหลดข้อมูลเพลง..."
        
        task.spawn(function()
            task.wait(0.3)
            if lastRequestTick ~= currentTick then return end
            
            local songInfo = GetSongInfo(musicId)
            if lastRequestTick == currentTick then
                SongInfoLabel.Text = "🎵 ชื่อเพลง: " .. songInfo.Name .. "\n👤 คนทำเพลง: " .. songInfo.Creator
            end
        end)
    else
        SongInfoLabel.Text = "🎵 ชื่อเพลง: -\n👤 คนทำเพลง: -"
    end
end
IDInput:GetPropertyChangedSignal("Text"):Connect(UpdateSongInfo)

SpawnBoomboxButton.MouseButton1Click:Connect(function()
    pcall(function()
        local re = ReplicatedStorage:FindFirstChild("RE")
        if re and re:FindFirstChild("1Too1l") then
            re["1Too1l"]:InvokeServer("PickingTools", "Boombox")
        end
        task.wait(0.3)
        if Player.Character then
            local tool = Player.Character:FindFirstChild("Boombox")
            if tool then setupBoomboxEffect(tool) end
        end
        if Player.Backpack then
            local toolInBackpack = Player.Backpack:FindFirstChild("Boombox")
            if toolInBackpack then setupBoomboxEffect(toolInBackpack) end
        end
    end)
end)

-- ปุ่มเล่นเพลง (รันแยก Thread ป้องกันค้าง)
PlayBoomboxButton.MouseButton1Click:Connect(function()
    local musicId = IDInput.Text:gsub("%D", "")
    if musicId ~= "" then
        if musicId == lastPlayedId or isPlaying then
            return 
        end
        
        isPlaying = true
        lastPlayedId = musicId
        
        task.spawn(function()
            local payload = buildPayload(musicId)
            pcall(function()
                local re = ReplicatedStorage:FindFirstChild("RE")
                if re then
                    if re:FindFirstChild("PlayerToolEvent") then
                        re.PlayerToolEvent:FireServer("ToolMusicText", payload, nil, true)
                    end
                    if re:FindFirstChild("BoomboxEvent") then
                        re.BoomboxEvent:FireServer(payload)
                    end
                    if re:FindFirstChild("PlayMusic") then
                        re.PlayMusic:FireServer(payload)
                    end
                end
                
                local char = Player.Character
                if char then
                    local boombox = char:FindFirstChild("Boombox") or Player.Backpack:FindFirstChild("Boombox")
                    if boombox then
                        if boombox.Parent == Player.Backpack then
                            boombox.Parent = char
                        end
                        boombox:Activate()
                        
                        local handle = boombox:FindFirstChild("Handle")
                        if handle then
                            local sound = handle:FindFirstChildWhichIsA("Sound")
                            if sound then
                                sound.SoundId = "rbxassetid://" .. musicId
                                sound:Play()
                            end
                        end
                    end
                end
            end)
            task.wait(0.5)
            isPlaying = false
        end)
    end
end)

StopButton.MouseButton1Click:Connect(function()
    lastPlayedId = ""
    isPlaying = false
    pcall(function()
        local re = ReplicatedStorage:FindFirstChild("RE")
        if re and re:FindFirstChild("PlayerToolEvent") then
            re.PlayerToolEvent:FireServer("ToolMusicText", "", nil, true)
        end
        local char = Player.Character
        if char then
            local boombox = char:FindFirstChild("Boombox")
            if boombox and boombox:FindFirstChild("Handle") then
                local sound = boombox.Handle:FindFirstChildWhichIsA("Sound")
                if sound then sound:Stop() end
            end
        end
    end)
end)

local isMinimized = false
MinimizeButton.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    ContentFrame.Visible = not isMinimized
    MinimizeButton.Text = isMinimized and "□" or "—"
    TweenService:Create(MainFrame, TweenInfo.new(0.2), {
        Size = isMinimized and UDim2.new(0, 350, 0, 40) or UDim2.new(0, 350, 0, 380)
    }):Play()
end)

CloseButton.MouseButton1Click:Connect(function()
    MainFrame.Visible = false
    ReopenButton.Visible = true
end)

ReopenButton.MouseButton1Click:Connect(function()
    MainFrame.Visible = true
    ReopenButton.Visible = false
end)

-- Drag System สำหรับ Main UI
local dragging, dragStart, startPos
TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)

TitleBar.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- Drag System สำหรับปุ่มลอย (Floating Button)
local floatDragging, floatDragStart, floatStartPos
ReopenButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        floatDragging = true
        floatDragStart = input.Position
        floatStartPos = ReopenButton.Position
    end
end)

ReopenButton.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        floatDragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if floatDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - floatDragStart
        ReopenButton.Position = UDim2.new(floatStartPos.X.Scale, floatStartPos.X.Offset + delta.X, floatStartPos.Y.Scale, floatStartPos.Y.Offset + delta.Y)
    end
end)
