local ID_PREFIX = ""
local ID_SUFFIX = ""

-- ตัวแปรเก็บประวัติ ID ล่าสุดที่กดเล่นไป และระบบ Cooldown ป้องกันกดรัว
local lastPlayedId = ""
local isPlaying = false

-- ====== ระบบเติม %30 จัดเต็ม 20,998 รอบ พร้อมระบบแจ้งเตือนผ่าน Alogger ======
local function buildPayload(rawId) 
    warn("กัน10022")
    
    local cleanId = rawId:match("%d+") or rawId
    
    local encoded = ""
    for i = 1, 20998 do
        encoded = encoded .. "%30"
    end
    
    return ID_PREFIX .. encoded .. cleanId .. ID_SUFFIX 
end

